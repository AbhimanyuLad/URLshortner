<style>
    .qr-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 50px;
    margin: 20px auto;
}

.qr-container img {
    width: 500px;
    height: 500px;
}

.qr-container a {
    text-decoration: none;
    background: #2563eb;
    color: white;
    padding: 10px 15px;
    border-radius: 6px;
}
</style>


<div class="qr-container">
    <img src="<%= qrCode %>" alt="QR Code">

    <a href="<%= qrCode %>" download="my-qrcode.png">
        Download QR Code
    </a>
</div>
